# Copy to ~/.hermes/profiles/bookwyrm/.env (install.sh does this once) and fill in.

# Fine-grained GitHub token scoped to the knowledge repo ONLY:
# Contents, Issues, Pull requests = Read and write. Nothing else.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Direct Anthropic API (model.provider: anthropic in config.yaml)
ANTHROPIC_API_KEY=

# Or a LiteLLM / OpenAI-compatible gateway (model.provider: custom, api_key_env: LITELLM_API_KEY)
# LITELLM_API_KEY=
